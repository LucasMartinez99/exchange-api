  "item": [
    {
      "name": "Convert Currency",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{basic_auth_username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{basic_auth_password}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from\": \"USD\",\n  \"to\": \"PEN\",\n  \"amount\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8081/api/v1/exchange/convert",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["api", "v1", "exchange", "convert"]
        }
      },
      "response": []
    },
    {
      "name": "Conversion History",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{basic_auth_username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{basic_auth_password}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8081/api/v1/exchange/history?startDate=2026-03-01&endDate=2026-03-31",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["api", "v1", "exchange", "history"],
          "query": [
            { "key": "startDate", "value": "2026-03-01" },
            { "key": "endDate",   "value": "2026-03-31" }
          ]
        }
      },
      "response": []
    },
    {
