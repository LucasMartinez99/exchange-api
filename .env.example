# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL (used by both Docker Compose and the app)
POSTGRES_DB=practica2
POSTGRES_USER=
POSTGRES_PASSWORD=

# Spring datasource (DB_HOST must be "db" when running with docker compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/practica2
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# External exchange rate API — get a key at apilayer.com
EXCHANGE_API_URL=https://api.apilayer.com/exchangerates_data
EXCHANGE_API_KEY=

# Basic Auth credentials for the API
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
